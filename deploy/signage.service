[Unit]
Description=Völk Digital Signage web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
Environment=SIGNAGE_DIR=__INSTALL_DIR__
Environment=SIGNAGE_BRANCH=__BRANCH__
ExecStartPre=/bin/bash __INSTALL_DIR__/scripts/update.sh
ExecStart=__INSTALL_DIR__/.venv/bin/gunicorn --workers 1 --bind 127.0.0.1:8000 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
